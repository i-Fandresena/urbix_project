# PostgreSQL local (voir compose.yaml) ou toute base PostgreSQL accessible au serveur.
DATABASE_URL=postgresql://hamarino:hamarino-local-dev@localhost:5432/hamarino

# Générez une valeur aléatoire longue ; gardez-la uniquement dans .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# SMTP facultatif : active la confirmation d’e-mail et la récupération du mot de passe.
# Exemple de forme : smtp://utilisateur:mot-de-passe@hote:587
AUTH_SMTP_URL=
AUTH_EMAIL_FROM=

# Bot Messenger : jeton de Page, clé secrète de l’application Meta et jeton de vérification du webhook.
# Le jeton de vérification est une valeur aléatoire choisie par l’équipe, recopiée dans la configuration du webhook Meta.
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# Administrateurs d’amorçage (gèrent l’équipe et les rôles), séparés par des virgules.
LAVERTA_ADMIN_EMAILS=

# Adresses traitées comme rédacteurs en chef tant qu’aucun rôle ne leur est attribué dans l’espace Équipe.
LAVERTA_EDITOR_EMAILS=

# Chiffrement AES-256-GCM des images jointes ; générer 32 octets aléatoires en base64.
# Exemple de génération : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
LAVERTA_MEDIA_ENCRYPTION_KEY=

# Créez une clé Gemini neuve, puis ajoutez-la uniquement sous cette variable locale.
# La clé partagée dans la conversation est compromise et ne doit pas être réutilisée.
# Ne collez jamais de clé Gemini dans le dépôt, le navigateur ou une conversation.
LAVERTA_GEMINI_API_KEY=
