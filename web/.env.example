# PostgreSQL local (voir compose.yaml) ou toute base PostgreSQL accessible au serveur.
DATABASE_URL=postgresql://hamarino:hamarino-local-dev@localhost:5432/hamarino

# Générez une valeur aléatoire longue ; gardez-la uniquement dans .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# SMTP facultatif : active la confirmation d’e-mail et la récupération du mot de passe.
# Exemple de forme : smtp://utilisateur:mot-de-passe@hote:587
AUTH_SMTP_URL=
AUTH_EMAIL_FROM=

# Bot Messenger : jeton de Page, clé secrète de l’application Meta et jeton de vérification du webhook.
# Le jeton de vérification est une valeur aléatoire choisie par l’équipe, recopiée dans la configuration du webhook Meta.
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# Créez une clé Gemini neuve, puis ajoutez-la uniquement dans ce fichier local.
# Ne collez jamais la clé Gemini dans le dépôt, le navigateur ou une conversation.
GEMINI_API_KEY=
