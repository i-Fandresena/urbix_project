# Créez un projet Supabase Free. Ces deux valeurs proviennent de Project Settings > API.
# La clé publishable est conçue pour le navigateur. N'ajoutez jamais la clé service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Créez une clé Gemini neuve, puis ajoutez-la uniquement dans ce fichier local.
# Ne collez jamais la clé Gemini dans le dépôt, le navigateur ou une conversation.
GEMINI_API_KEY=
