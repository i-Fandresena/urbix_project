{
  "name": "hamarino",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons:build": "node scripts/generate-brand-icon.mjs",
    "db:start": "docker compose -f compose.yaml up -d postgres",
    "db:stop": "docker compose -f compose.yaml down",
    "db:migrate": "dotenv -e .env.local -- npx auth@latest migrate --yes --config ./src/lib/auth.ts",
    "db:migrate:signalements": "dotenv -e .env.local -- node scripts/migrate-signalements.mjs",
    "signalements:export": "dotenv -e .env.local -- node scripts/export-signalements.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "better-auth": "^1.7.15",
    "geist": "^1.9.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
